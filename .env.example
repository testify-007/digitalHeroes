# ============================================================
# Digital Heroes — Environment Variables
# Copy to .env.local for local development. NEVER commit real values.
# In Vercel: add these via Project Settings → Environment Variables.
# ============================================================

# Supabase — required for all environments
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Subscription pricing (pence)
MONTHLY_PLAN_AMOUNT_MINOR=999
YEARLY_PLAN_AMOUNT_MINOR=9999

# ------------------------------------------------------------
# Stripe — NOT required in mock mode (payment flows use direct
# Supabase inserts). Uncomment and fill in when Stripe is
# available in your region.
# ------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MONTHLY_PRICE_ID=price_...
# STRIPE_YEARLY_PRICE_ID=price_...
